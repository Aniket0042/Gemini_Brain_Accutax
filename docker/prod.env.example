# Settings for docker-compose.prod.yml (NOT the app's secrets).
# Copy to docker/prod.env on the server and edit. docker/prod.env is git-ignored.

# Where CI pushes the images, and which build to run: "main" (latest) or a commit
# label like "sha-e619531". Roll back by setting an older label and running up -d.
AI_REGISTRY=ghcr.io/aniket0042
AI_IMAGE_TAG=main

# The app's own env file (database, Bedrock, gateway). See docker/app.env.example.
AI_ENV_FILE=/opt/accutax-ai/.env
# Cube's database settings and CUBEJS_API_SECRET. See semantic/cube.env.example.
CUBE_ENV_FILE=/opt/accutax-ai/cube.env
# Gateway key file from the Accutax team: owner 10001, mode 600.
AI_GATEWAY_KEY_FILE=/opt/accutax-ai/.secrets/ai-gateway.json
# UAE VAT knowledge base folder (documents.csv, pdfs/, builds/, CURRENT, models/).
AI_KB_DIR=/opt/accutax-ai-data/vat_kb_data

# Ports on 127.0.0.1 for the server's nginx.
AI_WEB_PORT=8020
AI_API_PORT=8021
