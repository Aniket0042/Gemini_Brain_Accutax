# Serves the built React UI and passes /api (and the API docs) to the backend.
# ${API_UPSTREAM} and ${WEB_LISTEN_PORT} are filled in when the container starts
# (nginx image templates). Other $variables are nginx's own and are left alone.

server {
    listen ${WEB_LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Document uploads (backend limit is 10 MB per file, 3 files per question).
    client_max_body_size 40m;

    location /api/ {
        proxy_pass http://${API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # /api/v1/query/stream is Server-Sent Events: must not be buffered.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location = /docs         { proxy_pass http://${API_UPSTREAM}/docs; }
    location = /redoc        { proxy_pass http://${API_UPSTREAM}/redoc; }
    location = /openapi.json { proxy_pass http://${API_UPSTREAM}/openapi.json; }

    # Hashed build files can be cached for a long time; index.html never.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
