# The app's own settings and secrets, read by the API container at start-up.
# Same keys as the .env the systemd service uses today; an existing .env works as is.
# Never put this file in the image or in git. Values here are blanks to fill in.
#
# Addresses: with docker-compose.host.yml, 127.0.0.1 means the server itself (as today).
# With docker-compose.yml, 127.0.0.1 is the container; use a real host/IP, or
# host.docker.internal for a service on the server that listens beyond 127.0.0.1.

# ---- AWS Bedrock (models) ----
BEDROCK_REGION=
BEDROCK_MODEL_ID=
BEDROCK_MODEL_ID_FAST=
BEDROCK_MAX_TOKENS=
# Credentials: on EC2 the instance role works with docker-compose.host.yml. Anywhere
# else, give keys here (the container cannot see the server's ~/.aws folder).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# ---- Accutax app ----
ACCUTAX_BASE_URL=
ACCUTAX_AUTH_TOKEN=
ACCUTAX_USER_ID=
ACCUTAX_ORG_ID=
ACCUTAX_SERVICE_EMAIL=
ACCUTAX_SERVICE_PASSWORD=
ACCUTAX_JWT_SECRET=

# ---- Databases ----
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_1_5_HOST=
DB_1_5_PORT=
DB_1_5_NAME=
DB_1_5_USER=
DB_1_5_PASSWORD=

# ---- Cube semantic layer ----
CUBE_API_URL=
CUBE_API_SECRET=

# ---- Auth and features ----
JWT_SECRET=
MULTI_ORG_ENABLED=
MAX_ORGS_PER_QUERY=
VAT_KB_ENABLED=
# VAT_KB_DIR is set to /kb by the compose file; the host folder is AI_KB_DIR in deploy.env.
VAT_KB_MODEL_ID=
UPLOADS_ENABLED=
SHOW_SQL_TRACES=
SHOW_API_TRACES=
SHOW_LLM_TRACES=

# Storage paths are fixed by the image (all under the /data volume):
# ARTIFACT_DIR, UPLOAD_DIR, PENDING_ACTION_DIR, logs/ and data/mcp. Leave them out.
