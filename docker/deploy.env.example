# Settings for docker-compose.yml / docker-compose.host.yml (NOT the app's secrets).
# Copy to docker/deploy.env on each server and edit. docker/deploy.env is git-ignored.

# Version label for the images, e.g. the git commit. Roll back by starting an older tag.
AI_IMAGE_TAG=latest

# The app's own env file (database, Bedrock, Accutax, JWT secrets), relative to the
# repository root or absolute. On the VM this is the existing /opt/accutax-ai/.env.
# See docker/app.env.example for the keys.
AI_ENV_FILE=.env

# Folder on the server holding the UAE VAT knowledge base (documents.csv, pdfs/,
# builds/, CURRENT, models/). On the VM: /opt/accutax-ai-data/vat_kb_data
AI_KB_DIR=./vat_kb_data

# Port the web UI answers on. Pick a free one (ss -tlnp) for a side-by-side test.
AI_WEB_PORT=8020
# docker-compose.yml only: 127.0.0.1 to keep it private behind the server's own nginx.
AI_WEB_BIND=0.0.0.0
# docker-compose.host.yml only: the API's port on 127.0.0.1.
AI_API_PORT=8021

# ---- Frontend build values (baked into the web image when it is built) ----
# legacy = the AI backend's own sign-in (the VM). Empty = shared Accutax sign-in (BFF),
# which then needs VITE_BFF_API_URL and VITE_HUB_URL.
VITE_AUTH_MODE=legacy
VITE_BFF_API_URL=
VITE_HUB_URL=
VITE_ACCUTAX_APP_URL=
VITE_SHOW_SQL_TRACES=
VITE_SHOW_API_TRACES=
VITE_SHOW_LLM_TRACES=
VITE_SHOW_PRIVACY_BADGE=
ALLOW_INSECURE_BFF=
