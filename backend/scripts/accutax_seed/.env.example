# Copy to .env next to the scripts (or point ACCUTAX_SEED_ENV at another file).
# Never commit the real .env.

# Accutax API the scripts call (staging first; never the shared database first).
BASE_URL=http://localhost:8081

# Required by the large seeds, as a guard against running them by accident.
ALLOW_LARGE_SEED=false

# Login used by the seeds. seed-org-5yr-data.ts also accepts --email / --password.
SEED_EMAIL=
SEED_PASSWORD=

# Queue backpressure for seed-org-5yr-data.ts (optional; without Redis it waits 60s before paying invoices).
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Only seed-5yr-invoices.ts reads the database directly (organizations, accounts, items).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=

# Optional seed-org-5yr-data.ts defaults
SEED_NUMBER_PREFIX=SEEDV2
SEED_MAX_REJECT_PCT=2
