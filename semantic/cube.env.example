# Copy to cube.env (git-ignored by *.env), fill in, chmod 600.
# Database: the read-only cube_reader role from semantic/dba/cube_reader.sql.
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=<db-host>
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=accutax_bk_1_5
CUBEJS_DB_USER=cube_reader
CUBEJS_DB_PASS=
# openssl rand -hex 32. The same value goes into Gemini Brain's .env as CUBE_API_SECRET.
# cube.js refuses to start when this is missing or shorter than 32 characters.
CUBEJS_API_SECRET=
