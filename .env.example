# ─────────────────────────────────────────────────────────────
# Gemini Brain — Environment Variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Google Gemini ──────────────────────────────────────────────
# REQUIRED: Google Gemini API Key (no hardcoded fallback)
GEMINI_API_KEY=your-gemini-api-key-here

# ── AWS Bedrock ────────────────────────────────────────────────
# AWS credentials are read from the standard AWS credential chain
# (env vars, ~/.aws/credentials, IAM role, etc.)
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID_FAST=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=2000

# ── Accutax Backend API ────────────────────────────────────────
ACCUTAX_BASE_URL=http://localhost:8081
ACCUTAX_AUTH_TOKEN=your-jwt-token-here
ACCUTAX_USER_ID=18

# ── PostgreSQL Database ────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=accutax_bk
DB_USER=postgres
DB_PASSWORD=your-db-password-here

# ── Optional Defaults ──────────────────────────────────────────
# ACCUTAX_ORG_ID=199
