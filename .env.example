# Accutax AI backend: configuration reference. Copy to `.env` (git-ignored) in this directory (the repository root).
# The settings file (backend/src/gemini_brain/config/settings.py) loads `accutax-ai/.env`, NOT `backend/.env`.
# Variables already set in the process environment win over this file.
# Names only: fill in your own values. Where a value is shown it is the code's default or a safe example.
# An empty `NAME=` overrides the code's default with an empty string, so settings whose default is not empty are either
# shown with that default or commented out. Delete a line to get the default.
# Never commit real values. In production the secrets come from the platform (ECS task secrets), not a file.

# ── Runtime mode ───────────────────────────────────────────
# production refuses to start unless AI_AUTH_MODE=gateway, and refuses http:// gateway addresses.
# NODE_ENV=production
# Alternative to `--port` for backend/server.py.
# PORT=8000
API_HOST=0.0.0.0
API_PORT=8000

# ── Authentication ─────────────────────────────────────────
# gateway: the private mode used in production. Only the Accutax API (Nest) may call this service, with a service key plus a
#          one-time delegation; there are no logins or tokens of its own and CORS is closed.
# legacy:  the old own-login / JWT / handoff mode, for isolated local work only.
AI_AUTH_MODE=gateway
# Path to the private JSON (mode 0600) holding upstream, resolveUrl, gatewayToAiKey, aiToGatewayKey.
# See docs/AI_SERVER_SETUP.md. Never put those keys in this file.
AI_GATEWAY_CONFIG_FILE=

# Legacy mode only (ignored and removed from the environment in gateway mode):
# ACCUTAX_BASE_URL=http://localhost:8081
# ACCUTAX_APP_URL=http://localhost:5173
JWT_SECRET=
ACCUTAX_JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
HANDOFF_SERVICE_KEY=
# JSON list of test accounts created at startup; empty means no seeding.
SEED_TEST_USERS=

# Browser origins allowed in legacy mode (comma-separated). Leave empty for gateway mode: browsers never call this service.
# Local dev origins: http://localhost:5173, http://localhost:5175 (the AI frontend), and their 127.0.0.1 forms.
CORS_ORIGINS=

# ── AWS Bedrock ────────────────────────────────────────────
# Credentials come from the default AWS chain (instance/task role, AWS_PROFILE, AWS_ACCESS_KEY_ID ...), not from here.
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=in.anthropic.claude-sonnet-5
BEDROCK_MODEL_ID_FAST=in.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=2000
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=45
BEDROCK_MAX_ATTEMPTS=2

# ── PostgreSQL (the AI's own tables: chats, bots, usage, uploads metadata) ──
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=accutax_llm
DB_USER=accutax_llm_user
DB_PASSWORD=
DB_NAME_ALLOWLIST=
DB_POOL_ENABLED=true
DB_POOL_MAX=10

# ── Cube semantic layer (all figures come through it) ──────
# Cube listens on loopback only. CUBE_API_SECRET must match CUBEJS_API_SECRET in semantic/cube.env (32+ characters).
# Empty secret disables every Cube call.
CUBE_API_URL=http://127.0.0.1:4000
CUBE_API_SECRET=
CUBE_JWT_AUDIENCE=accutax-cube
CUBE_JWT_ISSUER=gemini-brain
REPORT_TIMEZONE=Asia/Dubai

# ── Agent ──────────────────────────────────────────────────
AGENT_MODEL_ID=
AGENT_ANSWER_MODEL_ID=
# Comma-separated model keys users may pick: sonnet-5, haiku-4.5, haiku-3.
AGENT_MODELS=sonnet-5
AGENT_MODEL_USERS=
AGENT_MAX_TOOL_CALLS=6
AGENT_DEADLINE_SECONDS=45
AED_RATES_FILE=
# JSON-lines logs, relative to backend/. Empty turns the answer log and usage ledger off.
AGENT_AUDIT_LOG=logs/agent_audit.jsonl
AGENT_ANSWER_LOG=
MAX_ORGS_PER_QUERY=5
MULTI_ORG_ENABLED=false
SHOW_SQL_TRACES=true
SHOW_API_TRACES=true
SHOW_LLM_TRACES=true
MODEL_DIAGNOSTIC_ADMINS=

# ── UAE VAT knowledge base (FTA documents, with cited sources) ──
VAT_KB_ENABLED=false
VAT_KB_SHADOW=false
# Directory with documents.csv, pdfs/, builds/ and CURRENT. Empty: the search tool reports it is unavailable.
VAT_KB_DIR=
VAT_KB_MODEL_ID=
VAT_KB_TIMEOUT_SECONDS=3

# ── Reports and generated files ────────────────────────────
REPORT_NARRATIVE_MODE=llm
REPORT_NARRATIVE_MODEL_ID=
REPORT_NARRATIVE_TIMEOUT_SECONDS=20
REPORT_RENDER_TIMEOUT_SECONDS=45
ARTIFACT_DIR=
ARTIFACT_SPEC_RETENTION_DAYS=30
ARTIFACT_MAX_BYTES=26214400
ARTIFACT_TTL_SECONDS=86400

# ── File upload in chat ────────────────────────────────────
UPLOADS_ENABLED=false
UPLOAD_USERS=
UPLOAD_DIR=
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PAGES=20
UPLOAD_MAX_FILES=3
UPLOAD_DAILY_PAGES=100
# claude (Bedrock reads scans and photos) or none (text files only).
UPLOAD_EXTRACTOR=claude
UPLOAD_EXTRACT_MODEL=in.anthropic.claude-sonnet-5
UPLOAD_READ_TIMEOUT_SECONDS=180
UPLOAD_READ_WORKERS=4
UPLOAD_READ_MAX_TOKENS=12000
UPLOAD_CHUNK_PAGES=5

# ── Bots ───────────────────────────────────────────────────
# Shared secret for backend-to-backend triggers (POST /api/v1/bots/tick and /event).
BOT_SERVICE_TOKEN=
# Run the bot scheduler inside this service. Turn on in one environment's service only.
BOT_SCHEDULER_ENABLED=false
BOT_SCHEDULER_INTERVAL_SECONDS=300

# ── AI usage limits and spend records ──────────────────────
USAGE_LEDGER=
USAGE_DB=off
# off | log | soft | hard. Needs USAGE_DB=on.
USAGE_ENFORCE=off
USAGE_TIMEZONE=Asia/Dubai
USAGE_LITE_MODEL=haiku-4.5
USAGE_PLATFORM_ALERT_USD=25
USAGE_PLATFORM_PAUSE_USD=100
USAGE_RATE_PER_MINUTE=5
USAGE_ADMINS=

# ── Privacy: masking of names and identifiers before they reach the model ──
# PII_MODE: off | shadow | on.  PII_SENTINEL: off | report | strict.  PII_SNAPSHOTS: off | on.
PII_MODE=off
PII_SENTINEL=off
PII_SNAPSHOTS=off
PII_BADGE=on
PII_CARD_GUARD=on
PII_DEMO_ORGS=
PII_SNAPSHOT_USERS=
PII_SNAPSHOT_SAMPLE_PCT=100
PII_SNAPSHOT_ADMINS=
# Fernet key for the encrypted raw side of snapshots. Empty: the raw side is not kept.
PII_SNAPSHOT_KEY=
PII_SNAPSHOT_DIR=logs/pii_snapshots
PII_SNAPSHOT_RAW_DAYS=7
PII_SNAPSHOT_DAYS=30
PII_SENTINEL_LOG=logs/pii_sentinel.jsonl
