# Browser requests use the Nest BFF session and authenticated AI gateway.
# Set the real HTTPS Nest API origin in the production build environment.
VITE_BFF_API_URL=https://api.example.com
VITE_ACCUTAX_APP_URL=https://app.example.com

# Shared Accutax sign-in (Hub)
VITE_HUB_URL=https://accounts.zereco.ai

# bff (default): shared sign-in above. legacy: the AI backend's own login and the VM dashboard widget handoff.
# VITE_AUTH_MODE=legacy
