# FastAPI/uvicorn app. Bound to 127.0.0.1 only -- nginx is the public-facing edge.
# Port 8010 (not 8000) -- this instance already runs another API on 8000
# (/home/ubuntu/llm-env, unrelated to this project) plus other services on
# 8001/11434. This unit does not depend on a DB tunnel service: on this box
# the tunnel to 106.51.80.81 is already running ad hoc on 127.0.0.1:5435 and
# is intentionally left alone rather than replaced with a managed unit.
#
# Install:
#   sudo cp gemini-brain-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gemini-brain-api

[Unit]
Description=Gemini Brain FastAPI service
After=network.target

[Service]
Type=simple
User=geminibrain
WorkingDirectory=/opt/gemini-brain
EnvironmentFile=/opt/gemini-brain/.env
ExecStart=/opt/gemini-brain/venv/bin/uvicorn gemini_brain.api.app:app \
    --host 127.0.0.1 --port 8010 --app-dir /opt/gemini-brain/src
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
